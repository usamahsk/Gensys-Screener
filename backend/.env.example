# Backend (optional overrides)
KFC_DATABASE_URL=postgresql+asyncpg://kfc:kfc@localhost:5433/kfc
KFC_CORS_ORIGINS=*

# Optional: Gemini key improves call summaries + FAQ embeddings.
# Leave empty to run fully offline with local fallbacks.
KFC_GEMINI_API_KEY=
KFC_GEMINI_MODEL=gemini-2.0-flash

# Boot-seed sample orders/customers/calls when tables are empty (dev default true).
# Set to false in production so a wiped DB is never silently re-seeded.
KFC_SEED_ENABLED=true
