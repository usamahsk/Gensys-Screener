# Local development env — copy to .env and adjust as needed.
#   cp .env.example .env
# Never commit .env (it may contain passwords).

POSTGRES_USER=kfc
POSTGRES_PASSWORD=kfc
POSTGRES_DB=kfc
POSTGRES_PORT=5433

KFC_DATABASE_URL=postgresql+asyncpg://kfc:kfc@db:5432/kfc
KFC_CORS_ORIGINS=*
KFC_GEMINI_API_KEY=
KFC_GEMINI_MODEL=gemini-3.5-flash
KFC_SEED_ENABLED=true

API_PORT=8100
DASHBOARD_PORT=3100
NEXT_PUBLIC_API_URL=http://localhost:8100
