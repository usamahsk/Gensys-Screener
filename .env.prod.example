# Production env for dsquare.larynxai.in — copy to .env.prod on the server, never commit.
#   cp .env.prod.example .env.prod && nano .env.prod
POSTGRES_USER=kfc
POSTGRES_PASSWORD=kfc
POSTGRES_DB=kfc

# Image tags pulled from GHCR
GHCR_OWNER=usamahsk
API_TAG=latest
DASHBOARD_TAG=latest

# Compose prod overlay reads these:
KFC_DB_PASSWORD=change-me-to-a-long-random-password
KFC_GEMINI_API_KEY=
KFC_GEMINI_MODEL=gemini-3.5-flash

# Override base compose defaults:
NEXT_PUBLIC_API_URL=https://dsquare.larynxai.in
KFC_CORS_ORIGINS=https://dsquare.larynxai.in,http://127.0.0.1:3100,http://localhost:3100

# Boot seeding disabled in prod
KFC_SEED_ENABLED=false
